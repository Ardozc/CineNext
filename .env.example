# Bu dosyayı backend/.env olarak kopyalayın ve kendi değerlerinizi girin.
# .env.example GitHub'a gönderilir, gerçek .env dosyası gönderilmez.

PORT=3000

# TMDb API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API — https://aistudio.google.com/app/apikey
# Faturalandırma (billing) açılmamış bir projenin key'i ücretsiz katmanda çalışır.
GEMINI_API_KEY=your_gemini_api_key_here

# İsteğe bağlı: kullanılacak Gemini modeli (varsayılan: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
