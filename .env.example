# Bu dosyayı backend/.env olarak kopyalayın ve kendi değerlerinizi girin.
# .env.example GitHub'a gönderilir, gerçek .env dosyası gönderilmez.

PORT=3000

# TMDb API (https://www.themoviedb.org/settings/api) — 2. aşamada kullanılacak
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API (https://aistudio.google.com/app/apikey) — 3. aşamada kullanılacak
GEMINI_API_KEY=your_gemini_api_key_here
